<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # One address for the site: https://www.aurasea.org (search engines see no duplicates, browsing is encrypted).
  # SSL certificate checks (/.well-known) stay reachable over plain http.
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} !^www\. [NC]
  RewriteRule ^(.*)$ https://www.aurasea.org/$1 [R=301,L]

  # Single-page app: every path that is not a real file is served by index.html
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # Built files have a content hash in the name (index-TH6cLNav.js): cache them for a year
  <FilesMatch "-[A-Za-z0-9_-]{8}\.(js|css|webp|png|jpe?g|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Fonts, icons, video without a hash: a week
  <FilesMatch "\.(ttf|woff2?|ico|mp4)$|^favicon">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
